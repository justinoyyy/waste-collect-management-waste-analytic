
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7f4;
    color: #26332d;
    display: flex;
    min-height: 100vh;
}

button, input, select {
    font: inherit;
}

button {
    cursor: pointer;
}

.sidebar {
    width: 230px;
    flex-shrink: 0;
    background: #fff;
    border-right: 1px solid #e0e6e0;
    padding: 22px 14px;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.sidebar h2 {
    text-align: center;
    font-size: 21px;
    line-height: 1.4;
    color: #27392c;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-link {
    border: none;
    border-radius: 5px;
    background: transparent;
    color: #59645b;
    text-align: left;
    padding: 12px 10px;
    font-size: 13px;
    line-height: 1.5;
}

.nav-link:hover,
.nav-link.active {
    background: #2e7d32;
    color: white;
}

.main-content {
    flex: 1;
    min-width: 0;
    padding: 24px;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
}

.page-header h1 {
    font-size: 24px;
    margin-bottom: 7px;
}

.page-header p {
    color: #68736a;
    font-size: 13px;
}

.primary-btn {
    background: #2e7d32;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: bold;
}

.primary-btn:hover {
    background: #256529;
}

.secondary-btn {
    background: #edf1ed;
    color: #354238;
    border: 1px solid #dce3dc;
    border-radius: 6px;
    padding: 12px 16px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
}

.stat-card {
    background: white;
    border: 1px solid #e0e6e0;
    border-radius: 8px;
    padding: 20px 12px;
    text-align: center;
}

.stat-card p {
    color: #647067;
    font-size: 12px;
    margin-bottom: 10px;
}

.stat-card h2 {
    font-size: 23px;
    color: #2e7d32;
    overflow-wrap: anywhere;
}

.card {
    background: white;
    border: 1px solid #e0e6e0;
    border-radius: 9px;
    padding: 22px;
    margin-bottom: 22px;
    min-width: 0;
}

.card > h2,
.card-heading h2 {
    font-size: 18px;
}

.collection-form[hidden],
.page[hidden] {
    display: none;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 22px;
}

.form-grid label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 9px;
}

.form-grid input,
.form-grid select,
.filters input,
.filters select,
.card-heading input,
.period-select {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid #dfe5df;
    border-radius: 6px;
    background: #f8faf8;
    color: #354238;
    font-size: 13px;
}

input:focus,
select:focus {
    outline: 1px solid #39834a;
    border-color: #39834a;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 22px;
}

.card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
}

.card-heading input {
    max-width: 300px;
}

.filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

th, td {
    padding: 14px 10px;
    border-bottom: 1px solid #e8ede8;
    font-size: 12px;
    white-space: nowrap;
}

th {
    color: #58645a;
    background: #f8faf8;
}

td {
    color: #354238;
}

.status {
    display: inline-block;
    padding: 6px 9px;
    border-radius: 20px;
    font-size: 11px;
    background: #e8f4e8;
    color: #2e7d32;
}

.status.missed {
    background: #fdecea;
    color: #b52c22;
}

.status.in-progress {
    background: #fff2d8;
    color: #8a6200;
}

.delete-btn {
    background: #fbe9e7;
    color: #b52c22;
    border: none;
    padding: 7px 10px;
    border-radius: 5px;
    font-size: 11px;
}

.empty-message {
    padding: 24px 8px;
    color: #68736a;
    font-size: 13px;
}

.empty-message[hidden] {
    display: none;
}

.analytics-stats {
    grid-template-columns: repeat(4, minmax(0, 1fr));
}

.analytics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.chart-card,
.performance-card {
    min-height: 230px;
    margin-bottom: 0;
}

.chart-card > h2,
.performance-card > h2 {
    text-align: center;
    text-transform: uppercase;
    font-size: 15px;
    padding-bottom: 14px;
    border-bottom: 1px solid #e8ede8;
}

.bar-chart {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 16px;
}

.bar-row {
    display: grid;
    grid-template-columns: 90px minmax(30px, 1fr) 65px;
    align-items: center;
    gap: 9px;
    font-size: 12px;
}

.bar-label {
    text-align: right;
    overflow-wrap: anywhere;
}

.bar-track {
    height: 13px;
    background: #edf1ed;
    border-radius: 3px;
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    background: #2e7d32;
    border-radius: 3px;
}

.bar-value {
    font-size: 11px;
}

.category-item {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 15px 0;
    font-size: 13px;
}

.category-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #39834a;
    flex-shrink: 0;
}

.category-item:nth-child(2) .category-dot {
    background: #77a86b;
}

.category-item:nth-child(3) .category-dot {
    background: #a5b6a1;
}

.category-item:nth-child(4) .category-dot {
    background: #c4cfc4;
}

.performance-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #edf0ed;
    font-size: 13px;
}

.performance-row strong {
    color: #2e7d32;
}

.chart-empty {
    color: #68736a;
    font-size: 13px;
    text-align: center;
    padding: 28px 10px;
}

footer {
    text-align: center;
    padding: 25px 0 5px;
    color: #7a847c;
    font-size: 12px;
}

@media (max-width: 1100px) {
    .sidebar {
        width: 200px;
    }

    .main-content {
        padding: 18px;
    }

    .stats-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .form-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    body {
        display: block;
    }

    .sidebar {
        width: 100%;
        padding: 14px;
        gap: 16px;
    }

    .sidebar h2 {
        font-size: 19px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .main-content {
        padding: 14px;
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .stats-grid,
    .analytics-stats {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .form-grid,
    .analytics-grid,
    .filters {
        grid-template-columns: 1fr;
    }

    .card {
        padding: 15px;
    }

    .card-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .card-heading input {
        max-width: none;
    }
}
