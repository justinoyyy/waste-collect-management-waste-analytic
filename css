
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7f4;
    color: #26332d;
    display: flex;
    min-height: 100vh;
}

button, input, select {
    font: inherit;
}

button {
    cursor: pointer;
}

.sidebar {
    width: 230px;
    flex-shrink: 0;
    background: #fff;
    border-right: 1px solid #e0e6e0;
    padding: 22px 14px;
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.sidebar h2 {
    text-align: center;
    font-size: 19px;
    line-height: 1.5;
    color: #27392c;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.nav-btn {
    border: none;
    border-radius: 5px;
    background: transparent;
    color: #59645b;
    text-align: left;
    padding: 12px 10px;
    font-size: 13px;
    line-height: 1.5;
}

.nav-btn:hover,
.nav-btn.active {
    background: #2e7d32;
    color: #fff;
}

.main-content {
    flex: 1;
    min-width: 0;
    padding: 24px;
}

.page[hidden],
.form-card[hidden] {
    display: none;
}

.page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 22px;
}

.page-header h1 {
    font-size: 24px;
    margin-bottom: 7px;
}

.page-header p {
    color: #68736a;
    font-size: 13px;
}

.primary-btn {
    background: #2e7d32;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: bold;
}

.primary-btn:hover {
    background: #256529;
}

.secondary-btn {
    background: #edf1ed;
    color: #354238;
    border: 1px solid #dce3dc;
    border-radius: 6px;
    padding: 12px 16px;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 22px;
}

.stat-card {
    background: #fff;
    border: 1px solid #e0e6e0;
    border-radius: 8px;
    padding: 20px 12px;
    text-align: center;
}

.stat-card p {
    color: #647067;
    font-size: 12px;
    margin-bottom: 10px;
}

.stat-card h2 {
    color: #2e7d32;
    font-size: 23px;
    overflow-wrap: anywhere;
}

.card {
    background: #fff;
    border: 1px solid #e0e6e0;
    border-radius: 9px;
    padding: 22px;
    margin-bottom: 22px;
    min-width: 0;
}

.card > h2,
.card-heading h2 {
    font-size: 18px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 22px;
}

.form-grid > div {
    min-width: 0;
}

.form-grid .full {
    grid-column: 1 / -1;
}

label {
    display: block;
    font-size: 13px;
    font-weight: bold;
    margin-bottom: 9px;
}

input,
select {
    width: 100%;
    min-width: 0;
    padding: 12px;
    border: 1px solid #dfe5df;
    background: #f8faf8;
    border-radius: 6px;
    font-size: 13px;
    color: #354238;
}

input:focus,
select:focus {
    outline: 1px solid #39834a;
    border-color: #39834a;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 22px;
}

.card-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
}

.card-heading input {
    max-width: 320px;
}

.table-wrap {
    width: 100%;
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

th,
td {
    padding: 14px 10px;
    border-bottom: 1px solid #e8ede8;
    font-size: 12px;
    white-space: nowrap;
}

th {
    color: #58645a;
    background: #f8faf8;
}

td {
    color: #354238;
}

.delete-btn {
    background: #fbe9e7;
    color: #b52c22;
    border: none;
    padding: 7px 10px;
    border-radius: 5px;
    font-size: 11px;
}

.delete-btn:hover {
    background: #f5d4d0;
}

.empty {
    padding: 24px 8px;
    color: #68736a;
    font-size: 13px;
}

.empty[hidden] {
    display: none;
}

footer {
    text-align: center;
    padding: 25px 0 5px;
    color: #7a847c;
    font-size: 12px;
}

@media (max-width: 1000px) {
    .sidebar {
        width: 200px;
    }

    .main-content {
        padding: 18px;
    }

    .form-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    body {
        display: block;
    }

    .sidebar {
        width: 100%;
        padding: 14px;
        gap: 16px;
    }

    .sidebar h2 {
        font-size: 19px;
    }

    .sidebar nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .main-content {
        padding: 14px;
    }

    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-grid .full {
        grid-column: auto;
    }

    .card {
        padding: 15px;
    }

    .card-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .card-heading input {
        max-width: none;
    }

    .form-actions {
        flex-direction: column;
    }

    .form-actions button {
        width: 100%;
    }
}
